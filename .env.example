# Smart Crop Advisory System - Environment Configuration
# Copy this file to .env and adjust variables as needed

# Environment mode: development, testing, production
CROP_ADVISORY_ENV=development

# Custom dataset and artifact paths (leave blank to use defaults)
# CROP_ADVISORY_DATASETS_DIR=datasets
# CROP_ADVISORY_ARTIFACTS_DIR=models

# Streamlit Server Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_HEADLESS=true

# Live Agmarknet APMC Mandi Data Feed (Data.gov.in)
DATAGOV_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Groq AI Multilingual Voice Copilot
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ElevenLabs Multilingual Text-to-Speech (Free Tier)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Z.ai Multimodal Vision AI (Karpo Lens)
ZAI_API_KEY=
ZAI_MODEL=glm-5.3-flash
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
